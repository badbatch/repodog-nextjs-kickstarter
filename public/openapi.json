{
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "opaque access token",
        "scheme": "bearer",
        "type": "http"
      }
    },
    "schemas": {
      "appSettingsSchema": {
        "type": "object",
        "properties": {
          "Application": {
            "type": "object",
            "properties": {
              "Environment": {
                "type": "string",
                "enum": [
                  "development",
                  "test",
                  "production"
                ]
              },
              "Name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "Environment",
              "Name"
            ]
          },
          "Bff": {
            "type": "object",
            "properties": {
              "BaseUrl": {
                "$ref": "#/components/schemas/bffBaseUrlSchema"
              }
            },
            "required": [
              "BaseUrl"
            ]
          },
          "Server": {
            "type": "object",
            "properties": {
              "Api": {
                "$ref": "#/components/schemas/serverApiSchema"
              },
              "Auth": {
                "$ref": "#/components/schemas/serverAuthSchema"
              }
            },
            "required": [
              "Api",
              "Auth"
            ]
          }
        },
        "required": [
          "Application",
          "Bff",
          "Server"
        ]
      },
      "bffBaseUrlSchema": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri"
          },
          {
            "type": "string",
            "pattern": "^\\/(?!\\/)"
          }
        ]
      },
      "credentialsSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 256,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "currentUserSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "policies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "userName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "policies",
          "roles"
        ]
      },
      "exampleResponseSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "registrationSchema": {
        "type": "object",
        "properties": {
          "confirmPassword": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "maxLength": 256,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "confirmPassword",
          "email",
          "password"
        ]
      },
      "serverApiSchema": {
        "type": "object",
        "properties": {
          "BaseUrl": {
            "type": "string",
            "format": "uri"
          },
          "TimeoutMs": {
            "type": "integer",
            "exclusiveMinimum": true,
            "minimum": 0
          }
        },
        "required": [
          "BaseUrl",
          "TimeoutMs"
        ]
      },
      "serverAuthSchema": {
        "type": "object",
        "properties": {
          "RefreshBufferSeconds": {
            "type": "integer",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "SessionMaxAgeSeconds": {
            "type": "integer",
            "exclusiveMinimum": true,
            "minimum": 0
          }
        },
        "required": [
          "RefreshBufferSeconds",
          "SessionMaxAgeSeconds"
        ]
      },
      "tokenResponseSchema": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "minLength": 1
          },
          "expiresIn": {
            "type": "number",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "refreshToken": {
            "type": "string",
            "minLength": 1
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken",
          "tokenType"
        ]
      }
    },
    "responses": {
      "400": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "code": {
                  "example": "400",
                  "type": "string"
                },
                "error": {
                  "example": "Invalid request parameters",
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "code": {
                  "example": "401",
                  "type": "string"
                },
                "error": {
                  "example": "Authentication required",
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        }
      },
      "403": {
        "description": "Forbidden",
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "code": {
                  "example": "403",
                  "type": "string"
                },
                "error": {
                  "example": "Access denied",
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        }
      },
      "404": {
        "description": "Not Found",
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "code": {
                  "example": "404",
                  "type": "string"
                },
                "error": {
                  "example": "Resource not found",
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        }
      },
      "409": {
        "description": "Conflict",
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "code": {
                  "example": "409",
                  "type": "string"
                },
                "error": {
                  "example": "Resource already exists",
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        }
      },
      "500": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "code": {
                  "example": "500",
                  "type": "string"
                },
                "error": {
                  "example": "An unexpected error occurred",
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        }
      }
    }
  },
  "info": {
    "description": "The BFF contract for the paired application starter.",
    "title": "Kickstarter BFF",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "servers": [
    {
      "description": "Local development server",
      "url": "http://localhost:3000/api"
    }
  ],
  "paths": {
    "/example": {
      "get": {
        "operationId": "get-example",
        "summary": "",
        "description": "",
        "tags": [
          "Example"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/exampleResponseSchema"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/example/restricted": {
      "get": {
        "operationId": "get-example-restricted",
        "summary": "",
        "description": "",
        "tags": [
          "Example"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/exampleResponseSchema"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Example"
    }
  ]
}
