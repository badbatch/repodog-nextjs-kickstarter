KICKSTARTER_SERVER__API__BASE_URL=http://localhost:8080
KICKSTARTER_BFF__BASE_URL=/api
NEXT_PUBLIC_LANGUAGE_CODE=en

# Generate a unique secret, e.g. openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Optional: send frontend logs to an OpenTelemetry Collector.
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# OTEL_SERVICE_NAME=repodog-nextjs-kickstarter

# Playwright: existing accounts in the API used for end-to-end tests.
# The privileged user needs the ExampleUser role; the user must not satisfy ExampleAccess.
E2E_PRIVILEGED_EMAIL=
E2E_PRIVILEGED_PASSWORD=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Optional: test an already-running English-language app instead of starting one on port 3100.
# E2E_BASE_URL=http://localhost:3000
