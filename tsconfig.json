{
  "extends": "@repodog/ts-config/index.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "incremental": true,
    "jsx": "preserve"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".storybook/main.ts",
    ".storybook/preview.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "jest.setup.ts",
    "appSettings.generated.d.ts"
  ],
  "exclude": ["node_modules"]
}
