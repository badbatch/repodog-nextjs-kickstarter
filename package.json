{
  "name": "repodog-nextjs-kickstarter",
  "description": "An opinionated Next.js application starter paired with repodog-dotnet-kickstarter.",
  "version": "1.0.0",
  "author": "miami-man",
  "private": true,
  "homepage": "https://github.com/miami-man/repodog-nextjs-kickstarter",
  "repository": {
    "type": "git",
    "url": "https://github.com/miami-man/repodog-nextjs-kickstarter.git"
  },
  "bugs": {
    "url": "https://github.com/miami-man/repodog-nextjs-kickstarter/issues"
  },
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "appsettings:types": "appsettings generate-types ./appSettings/schema.ts ./appSettings.generated.d.ts",
    "bs": "pnpm run build && pnpm run start",
    "bs:local": "pnpm run build && cp .env.local .next/standalone/.env && pnpm run start",
    "bs:local:debug": "DEBUG=true pnpm run build && cp .env.local .next/standalone/.env && NODE_OPTIONS=\"--enable-source-maps --inspect\" pnpm run start",
    "build": "del-cli ./.gql-query-whitelist && next build && pnpm run copy-files",
    "build-storybook": "storybook build",
    "clean:deps": "del-cli ./node_modules",
    "clean:dist": "del-cli ./.next",
    "copy-files": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "coverage-generate": "nyc report --reporter=lcov -t coverage --report-dir coverage",
    "coverage-open": "open-cli ./coverage/lcov-report/index.html",
    "cut:changelog": "changelog",
    "dev": "next dev",
    "dev:debug": "DEBUG=true pnpm run dev",
    "format": "prettier --check .",
    "generate": "pnpm run appsettings:types && pnpm run generate-server-client && pnpm run generate-bff-openapi-spec && pnpm run generate-bff-client",
    "generate-bff-client": "getta generate-client ./public/openapi.json ./bff/httpClient",
    "generate-bff-openapi-spec": "openapi-gen generate",
    "generate-server-client": "getta generate-client ./openapi.json ./server/httpClient",
    "jest": "JS_ENV=web COMPILER=swc node --require=suppress-experimental-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "lint": "pnpm run /^lint:.*/",
    "lint:code": "eslint .",
    "lint:css": "stylelint '**/*.css'",
    "lint:docs": "markdownlint-cli2 \"**/*.md\"",
    "prebuild": "pnpm run generate",
    "predev": "pnpm run generate",
    "prepare": "husky",
    "repodog": "repodog",
    "start": "node ./.next/standalone/server.js",
    "storybook": "storybook dev -p 6006",
    "syncpack": "syncpack format --check && syncpack lint",
    "test": "del-cli ./coverage && pnpm run jest && pnpm run coverage-generate",
    "test:e2e": "playwright test",
    "test:e2e:container": "node scripts/prepareE2e.ts && playwright test",
    "test:e2e:docker": "node scripts/testE2eDocker.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "pnpm run jest --runInBand --testMatch \"<rootDir>/**/*.integration.test.ts\"",
    "type-check": "pnpm run appsettings:types && tsc --noEmit --incremental false",
    "validate": "pnpm run syncpack && pnpm run build && pnpm run lint && pnpm run format && pnpm run type-check && pnpm run test"
  },
  "dependencies": {
    "@mantine/core": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@next-box/appsettings": "^0.0.10",
    "@next-box/breadcrumb": "^0.1.16",
    "@next-box/envs": "^0.2.4",
    "@next-box/feature-flags": "^0.1.4",
    "@next-box/i18n": "^0.1.3",
    "@next-box/link-extra": "^0.1.3",
    "@next-box/route-handler": "^0.0.2",
    "@next/bundle-analyzer": "^16.4.5",
    "@scalar/api-reference-react": "^0.9.89",
    "ajv": "^8.20.0",
    "date-fns": "^4.4.0",
    "getta": "^1.0.35",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "remeda": "^2.59.0",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@jest/globals": "^30.5.2",
    "@next/env": "^16.4.5",
    "@playwright/test": "^1.65.1",
    "@repodog/cli": "^1.7.10",
    "@repodog/commitlint-config": "^21.0.4",
    "@repodog/eslint-config": "^9.0.37",
    "@repodog/eslint-config-jest": "^9.0.12",
    "@repodog/eslint-config-playwright": "^9.0.11",
    "@repodog/eslint-config-react": "^9.0.13",
    "@repodog/jest-config": "^30.0.8",
    "@repodog/markdownlint-config": "^1.2.8",
    "@repodog/prettier-config": "^3.0.8",
    "@repodog/storybook-config": "^10.0.14",
    "@repodog/stylelint-config": "^1.0.3",
    "@repodog/swc-config": "^1.0.17",
    "@repodog/syncpack-config": "^15.0.7",
    "@repodog/ts-config": "^6.0.5",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "changelog": "^1.4.2",
    "concurrently": "^10.0.6",
    "core-js": "^3.51.0",
    "del-cli": "^8.0.1",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-environment-node": "^30.5.2",
    "markdownlint-cli2": "^0.24.0",
    "next-openapi-gen": "^1.10.0",
    "nyc": "^18.0.0",
    "open-cli": "^9.0.0",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "storybook": "^10.6.6",
    "stylelint": "^17.16.0",
    "suppress-experimental-warnings": "^2.0.0",
    "syncpack": "^15.3.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.14.0"
}
